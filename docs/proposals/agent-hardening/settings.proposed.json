{
  "permissions": {
    "defaultMode": "default",
    "disableBypassPermissionsMode": "disable",
    "allow": [
      "Read",
      "Glob",
      "Grep",
      "Bash(git status)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git branch --show-current)",
      "Bash(git remote -v)",
      "Bash(git ls-remote --heads origin)"
    ],
    "deny": [
      "Write(.claude/**)",
      "Edit(.claude/**)",
      "Write(CLAUDE.md)",
      "Edit(CLAUDE.md)",
      "Write(.env*)",
      "Edit(.env*)",
      "Read(.env*)",
      "Read(secrets/**)",
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git reset --hard*)",
      "Bash(git clean*)",
      "Bash(git merge*)",
      "Bash(rm *)",
      "Bash(curl *)",
      "Bash(wget *)",
      "WebFetch(domain:localhost)",
      "Bash(git -C *)",
      "Bash(git switch*)",
      "Bash(git checkout*)",
      "Write(.mcp.json)",
      "Edit(.mcp.json)",
      "Write(.vscode/**)",
      "Edit(.vscode/**)",
      "Write(.github/**)",
      "Edit(.github/**)",
      "PowerShell(git push --force*)",
      "PowerShell(git push -f*)",
      "PowerShell(git reset --hard*)",
      "PowerShell(git clean*)",
      "PowerShell(git merge*)",
      "PowerShell(Remove-Item*)",
      "PowerShell(Invoke-WebRequest*)",
      "PowerShell(Invoke-RestMethod*)"
    ],
    "ask": [
      "Bash(git push*)",
      "PowerShell(git push*)",
      "Bash(git commit*)",
      "PowerShell(git commit*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "python -I \"$CLAUDE_PROJECT_DIR/.claude/hooks/agent_guard.py\""
          }
        ]
      }
    ]
  }
}
